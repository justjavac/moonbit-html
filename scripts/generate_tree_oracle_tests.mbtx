----
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/json",
}
----

///|
async fn main raise {
  let log = @fs.read_file("scripts/oracles/tree.log").text()
  let output = StringBuilder()
  output.write_string("///|\nlet tree_oracles : Array[(String, String, Array[String])] = [\n")
  for line in log.split("\n") {
    guard line.strip_prefix("ORACLE ") is Some(payload) else { continue }
    match @json.parse(payload) {
      [String(name), String(input), Array(lines)] => {
        output.write_string("  (")
        output.write_string(name.escape())
        output.write_string(", ")
        output.write_string(input.escape())
        output.write_string(", [\n")
        for line in lines {
          match line {
            [Number(depth, ..), String(kind), String(detail)] => {
              let text = "\{depth.to_int()}|\{kind}|\{detail}"
              output.write_string("    ")
              output.write_string(text.escape())
              output.write_string(",\n")
            }
            _ => fail("invalid oracle line")
          }
        }
        output.write_string("  ]),\n")
      }
      _ => fail("invalid oracle case")
    }
  }
  output.write_string("]\n")
  @fs.write_file("src/internal/tree_oracle_data_wbtest.mbt", output.to_string(), create_mode=CreateOrTruncate)
  let selector_log = @fs.read_file("scripts/oracles/selector.log").text()
  let selectors = StringBuilder()
  selectors.write_string("///|\nlet selector_oracles : Array[(String, Array[Int])] = [\n")
  for line in selector_log.split("\n") {
    guard line.strip_prefix("ORACLE ") is Some(payload) else { continue }
    match @json.parse(payload) {
      [String(selector), Array(ids)] => {
        selectors.write_string("  (" + selector.escape() + ", [")
        for id in ids {
          match id {
            Number(value, ..) => selectors.write_string(value.to_int().to_string() + ",")
            _ => fail("invalid selector offset")
          }
        }
        selectors.write_string("]),\n")
      }
      _ => fail("invalid selector oracle")
    }
  }
  selectors.write_string("]\n")
  @fs.write_file("src/selector_oracle_data_test.mbt", selectors.to_string(), create_mode=CreateOrTruncate)
}
